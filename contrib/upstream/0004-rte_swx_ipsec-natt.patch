@@ -1369,7 +1476,13 @@ tunnel_ipv4_header_set(struct rte_ipv4_hdr *h, struct rte_swx_ipsec_sa_params *p
 		.packet_id = 0,
 		.fragment_offset = 0,
 		.time_to_live = 64,
-		.next_proto_id = IPPROTO_ESP,
+		/* The outer IPv4 proto is ESP when carrying ESP directly, but
+		 * RFC 3948 ESP-in-UDP (NAT-T) wraps ESP in UDP/4500, so the
+		 * outer proto must be UDP (17), not ESP (50).  rte_ipsec's
+		 * sa.c inserts the UDP header after this IPv4 hdr when
+		 * options.udp_encap is set; the outer proto has to match or a
+		 * receiver/tcpdump reads the UDP ports as the ESP SPI. */
+		.next_proto_id = p->encap.udp_encap ? IPPROTO_UDP : IPPROTO_ESP,
 		.hdr_checksum = 0, /* Cannot be pre-computed. */
 		.src_addr = p->encap.tunnel.ipv4.src_addr.s_addr,
 		.dst_addr = p->encap.tunnel.ipv4.dst_addr.s_addr,
@@ -1596,8 +1709,14 @@ ipsec_xform_get(struct rte_swx_ipsec_sa_params *p,
 
 	ipsec_xform->esn.value = 0;
 
-	ipsec_xform->udp.dport = 0;
-	ipsec_xform->udp.sport = 0;
+	/* RFC 3948 ESP-in-UDP (NAT-T) encapsulation.  The extern public API
+	 * carries udp_encap + ports in p->encap.udp; rte_ipsec's esp_outb
+	 * inserts the UDP header (sa.c gate on options.udp_encap) on encrypt
+	 * and checks/strips it on decrypt.  Default the ports to 4500 so a
+	 * caller that only sets udp_encap still frames correctly. */
+	ipsec_xform->options.udp_encap = p->encap.udp_encap;
+	ipsec_xform->udp.dport = p->encap.udp.dport ? p->encap.udp.dport : 4500;
+	ipsec_xform->udp.sport = p->encap.udp.sport ? p->encap.udp.sport : 4500;
 }
 
