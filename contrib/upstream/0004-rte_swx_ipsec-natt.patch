+	/** RFC 3948 ESP-in-UDP (NAT-T) encapsulation.  Non-zero marks the
+	 * SA as ESP-in-UDP: outbound, rte_ipsec inserts a UDP header (NAT-T)
+	 * into the tunnel (esp_outb) and the outer proto is set to UDP;
+	 * inbound, the r2dp extern's pre_crypto folds the 8-byte UDP header
+	 * out itself before rte_ipsec and builds the inbound SA with
+	 * udp_encap cleared (see rte_swx_ipsec.c).  The ports default to
+	 * 4500 when not set. */
+	int udp_encap;
