@@ -1785,7 +1904,18 @@ rte_swx_ipsec_sa_add(struct rte_swx_ipsec *ipsec,
 	/* Acquire the SA resources. */
 	sa = ipsec_sa_get(ipsec, sa_id);
 
-	status = ipsec_session_create(ipsec, sa_params, &sa->s);
+	/* Inbound NAT-T: pass a COPY with udp_encap cleared so rte_ipsec
+	 * inbound builds a plain-ESP SA (no UDP handling), matching the
+	 * manual strip that pre_crypto performs -- otherwise rte_ipsec
+	 * inbound would also expect/strip a UDP header and double-handle it.
+	 * (Outbound keeps udp_encap set so rte_ipsec inserts the UDP/4500
+	 * wrapper into the tunnel header.) */
+	{
+		struct rte_swx_ipsec_sa_params p = *sa_params;
+		if (!sa_params->encrypt)
+			p.encap.udp_encap = 0;
+		status = ipsec_session_create(ipsec, &p, &sa->s);
+	}
 	if (status) {
 		/* Free the allocated SADB entry. */
 		ipsec->sa_free_id[ipsec->n_sa_free_id] = sa_id;
